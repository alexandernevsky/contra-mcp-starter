{
  "name": "contra-mcp-starter",
  "version": "1.1.0",
  "description": "Zero-dependency starter kit and toolkit for automating your Contra profile, services, and portfolio case studies using Model Context Protocol (MCP) and AI coding agents.",
  "type": "module",
  "main": "scripts/contra-client.mjs",
  "scripts": {
    "auth": "node scripts/auth.mjs",
    "whoami": "node scripts/examples/whoami.mjs",
    "services": "node scripts/examples/inspect-services.mjs",
    "projects": "node scripts/examples/inspect-projects.mjs",
    "test": "node --test",
    "tools": "node scripts/examples/list-tools.mjs",
    "health": "node scripts/examples/health.mjs"
  },
  "keywords": [
    "contra",
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "portfolio",
    "freelance",
    "automation",
    "cursor",
    "antigravity",
    "claude-code",
    "codex"
  ],
  "author": "Alexander Nevsky <https://contra.com/alexander_nevsky>",
  "license": "MIT",
  "engines": {
    "node": ">=18.20.0"
  }
}
